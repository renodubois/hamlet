{
  "purpose": "Synthetic session configuration examples; configs[].value is file content, not this envelope. No credential values. Never use with a real provider/profile.",
  "provider_service": "org.hamlet.session.v1",
  "path_cases": [
    {
      "environment": {"XDG_CONFIG_HOME": "/synthetic/xdg", "HOME": "/synthetic/home"},
      "expected_path": "/synthetic/xdg/hamlet/session.json"
    },
    {
      "environment": {"XDG_CONFIG_HOME": "", "HOME": "/synthetic/home"},
      "expected_path": "/synthetic/home/.config/hamlet/session.json"
    },
    {
      "environment": {"HOME": "/synthetic/home"},
      "expected_path": "/synthetic/home/.config/hamlet/session.json"
    },
    {
      "environment": {},
      "expected_path": null
    }
  ],
  "account_key_cases": [
    {
      "selection": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
      "expected_account": "25:https://chat.example.test:synthetic-user-1"
    },
    {
      "selection": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "RenamedAda"}, "expires_at": 2000001000},
      "expected_account": "25:https://chat.example.test:synthetic-user-1"
    },
    {
      "selection": {"server": "https://chat.example.test/", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
      "expected_account": "26:https://chat.example.test/:synthetic-user-1"
    },
    {
      "selection": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-2", "username": "SyntheticBob"}, "expires_at": 2000000000},
      "expected_account": "25:https://chat.example.test:synthetic-user-2"
    },
    {
      "selection": {"server": "https://other.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
      "expected_account": "26:https://other.example.test:synthetic-user-1"
    },
    {
      "selection": {"server": "http://127.0.0.1:8081", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
      "expected_account": "21:http://127.0.0.1:8081:synthetic-user-1"
    }
  ],
  "configs": [
    {
      "name": "selected-login-with-old-user-deletion-pending",
      "value": {
        "server": "https://chat.example.test",
        "saved": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
        "pending_deletions": [
          {"server": "https://other.example.test", "user": {"id": "synthetic-old-user", "username": "SyntheticOld"}, "expires_at": 1900000000}
        ]
      },
      "expected_startup": "Prefill chat server and SyntheticAda; candidate is not active until verified. Resume old-user deletion independently.",
      "pending_deletion_account": "26:https://other.example.test:synthetic-old-user"
    },
    {
      "name": "last-successful-server-differs-after-failed-save",
      "value": {
        "server": "https://other.example.test",
        "saved": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
        "pending_deletions": []
      },
      "expected_startup": "Prefill other server; blank username and no restore candidate because saved.server differs exactly. Previous saved metadata remains."
    },
    {
      "name": "trailing-slash-is-not-the-same-selected-identity",
      "value": {
        "server": "https://chat.example.test/",
        "saved": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000},
        "pending_deletions": []
      },
      "expected_startup": "Both URLs validate, but exact spelling differs: no username prefill or restore candidate. Account keys distinguish exact server spellings."
    },
    {
      "name": "omitted-pending-deletions",
      "value": {
        "server": "https://chat.example.test",
        "saved": {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000}
      },
      "expected_startup": "Deserialize with empty pending_deletions; selected identity is eligible for verification, not immediate activation."
    },
    {
      "name": "logged-out-durable-deletion-intent",
      "value": {
        "server": "https://chat.example.test",
        "saved": null,
        "pending_deletions": [
          {"server": "https://chat.example.test", "user": {"id": "synthetic-user-1", "username": "SyntheticAda"}, "expires_at": 2000000000}
        ]
      },
      "expected_startup": "Prefill server only; do not restore pending identity. Retry deletion; retain intent on failure."
    }
  ]
}
