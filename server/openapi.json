          "items"
        ],
        "type": "object"
      },
      "ChannelType": {
        "enum": [
          "text"
        ],
        "type": "string"
      },
      "CreateChannel": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ChannelType"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "CreateMessage": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Event": {
        "oneOf": [
          {
            "properties": {
              "message": {
                "$ref": "#/components/schemas/Message"
              },
              "type": {
                "enum": [
                  "message_created"
                ],
                "type": "string"
              }
            },
            "required": [
              "message",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "channel": {
                "$ref": "#/components/schemas/Channel"
              },
              "type": {
                "enum": [
                  "channel_created"
                ],
                "type": "string"
              }
            },
            "required": [
              "channel",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "History": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array"
          },
